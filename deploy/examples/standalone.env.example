# Copy into an operator-controlled environment source. Do not commit populated
# values and do not place production secrets in this file.

PRG32_DATA_DIR=/srv/prg32/state/canonical
PRG32_KEY_REGISTRY_FILE=/srv/prg32/secrets/key-registry.json
PRG32_SECRET_DIR=/srv/prg32/secrets/application

PRG32_FRONTEND_PUBLIC_ORIGIN=https://store.example.test
PRG32_API_PUBLIC_ORIGIN=https://api.example.test
PRG32_WS_PUBLIC_URL=wss://api.example.test/api/multiplayer
PRG32_SESSION_COOKIE_DOMAIN=
PRG32_TRUST_PROXY=true

# Keep email disabled until an SMTP policy is approved. SMTP credentials must
# be injected by the operator's secret provider when transport is smtp.
PRG32_EMAIL_TRANSPORT=disabled
PRG32_EMAIL_FROM=no-reply@example.test
PRG32_SMTP_HOST=
PRG32_SMTP_PORT=587
PRG32_SMTP_USER=
PRG32_SMTP_PASSWORD=

# WebAuthn is intentionally disabled by default. Enable only after HTTPS,
# RP/origin compatibility and account-recovery policy are approved.
PRG32_WEBAUTHN_ENABLED=false
PRG32_WEBAUTHN_RP_ID=
PRG32_WEBAUTHN_ORIGINS=
