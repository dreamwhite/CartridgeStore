# Copy into an operator-controlled environment source. Do not commit populated
# values and do not place production secrets in this file.

PRG32_DATA_DIR=/srv/prg32/state/canonical
PRG32_KEY_REGISTRY_FILE=/srv/prg32/secrets/key-registry.json
PRG32_SECRET_DIR=/srv/prg32/secrets/application

PRG32_FRONTEND_PUBLIC_ORIGIN=https://store.example.test
PRG32_API_PUBLIC_ORIGIN=https://api.example.test
PRG32_WS_PUBLIC_URL=wss://api.example.test/api/multiplayer
PRG32_SESSION_COOKIE_DOMAIN=
PRG32_TRUST_PROXY=true

# SMTP, WebAuthn, OIDC, SAML and mDNS remain disabled or unconfigured by
# default. Configure them through the setup/admin workflow after HTTPS,
# outbound-network and account-recovery policies are approved.
