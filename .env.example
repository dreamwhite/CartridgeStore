# Generic local hostnames. Keep these aligned with dnsmasq and mkcert.
PRG32_STORE_DOMAIN=store.prg32.test
PRG32_API_DOMAIN=api.prg32.test
PRG32_STORE_ORIGIN=https://store.prg32.test
PRG32_API_ORIGIN=https://api.prg32.test
PRG32_SESSION_COOKIE_DOMAIN=.prg32.test

# Used by the generic Traefik overlay.
PRG32_TRAEFIK_NETWORK=prg32_edge
PRG32_TLS_DIR=./.local/tls
PRG32_HTTP_PORT=80
PRG32_HTTPS_PORT=443
