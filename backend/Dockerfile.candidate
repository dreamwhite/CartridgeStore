FROM node:24-bookworm-slim AS dependencies

WORKDIR /app
RUN apt-get update \
    && apt-get install --no-install-recommends -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@12.5.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# The candidate explicitly disables mDNS; keep the optional LAN advertiser
# out of the public two-service image as well as out of its startup path.
RUN pnpm install --frozen-lockfile --no-optional

FROM node:24-bookworm-slim AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY src ./src
RUN corepack enable && pnpm run build

FROM dependencies AS production-dependencies
RUN pnpm prune --prod --no-optional

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=development \
    PRG32_BACKEND_HOST=0.0.0.0 \
    PRG32_BACKEND_PORT=5090

WORKDIR /app
COPY --from=builder /app/package.json ./package.json
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

RUN mkdir -p /data/canonical /tmp/prg32 \
    && chown -R node:node /data /tmp/prg32 /app

USER node
EXPOSE 5090
CMD ["node", "dist/server.js"]
