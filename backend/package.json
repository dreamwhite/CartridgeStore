{
  "name": "prg32-cartridge-store-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only TypeScript backend foundation for PRG32 Cartridge Store",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "reconcile": "tsx src/reconcile.ts",
    "legacy:inventory": "tsx src/storage-v2/legacy/cli.ts inventory",
    "legacy:verify": "tsx src/storage-v2/legacy/cli.ts verify",
    "legacy:report": "tsx src/storage-v2/legacy/cli.ts report",
    "storage:migrate": "tsx src/storage-v2/migration/cli.ts migrate",
    "storage:resume": "tsx src/storage-v2/migration/cli.ts resume",
    "storage:verify": "tsx src/storage-v2/migration/cli.ts verify",
    "storage:status": "tsx src/storage-v2/migration/cli.ts status",
    "storage:dispose": "tsx src/storage-v2/migration/cli.ts dispose",
    "storage:parity": "tsx src/storage-v2/differential/cli.ts",
    "storage:backup": "tsx src/storage-v2/backup-cli.ts",
    "storage:backup-v4": "tsx src/storage-v2/backup-v4-cli.ts",
    "storage:candidate-init": "tsx src/storage-v2/candidate-init-cli.ts",
    "storage:bootstrap-operational": "tsx src/storage-v2/operational-bootstrap-cli.ts",
    "preflight:config": "tsx src/preflight/cli.ts",
    "readiness:report": "tsx src/readiness/cli.ts",
    "secrets:migrate": "tsx src/secrets/cli.ts migrate",
    "secrets:rollback": "tsx src/secrets/cli.ts rollback",
    "secrets:rotate": "tsx src/secrets/cli.ts rotate",
    "secrets:keygen": "tsx src/secrets/keygen.ts",
    "capacity:check": "tsx tests/operations/m63b-run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "11.3.4",
    "@node-saml/node-saml": "5.1.0",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.0",
    "fflate": "^0.8.3",
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "optionalDependencies": {
    "multicast-dns": "7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "8.5.10",
    "eslint": "^9.22.0",
    "node-gyp": "^11.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "ws": "8.18.3",
    "xml-crypto": "6.3.3"
  }
}
