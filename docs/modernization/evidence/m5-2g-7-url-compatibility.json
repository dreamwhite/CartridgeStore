{
  "abi": "prg32-url-compatibility-1.0",
  "milestone": "M5.2g.7",
  "same_origin_only": true,
  "query_parameters": "preserved unless a canonical page intentionally owns a fixed workflow target",
  "return_to_policy": "safeReturnPath rejects absolute, protocol-relative, encoded, backslash and control-character redirects",
  "mappings": [
    {"source":"/auth/login","target":"/login","query":"preserved","status":"implemented"},
    {"source":"/auth/register","target":"/register","query":"preserved","status":"implemented"},
    {"source":"/auth/register/complete","target":"/register/complete","query":"preserved","status":"implemented"},
    {"source":"/auth/tokens","target":"/account","query":"preserved","status":"implemented"},
    {"source":"/setup","target":"/admin?section=settings","query":"source query preserved; settings is default section","status":"implemented"},
    {"source":"/editor/submissions","target":"/review","query":"preserved","status":"implemented"},
    {"source":"/editor/submissions/:submission_id","target":"/review","query":"preserved","status":"implemented"},
    {"source":"/users/:username","target":"/users/:username","query":"preserved","status":"implemented in Next","reason":"Fastify profile summary contract exists"},
    {"source":"/users/:username/runs","target":"/users/:username/runs","query":"preserved","status":"implemented in Next","reason":"Fastify owner/admin run-list contract exists"},
    {"source":"/users/:username/runs/:run_id","target":"/users/:username/runs/:runId","query":"preserved","status":"implemented in Next","reason":"Fastify owner/admin run-detail contract exists"},
    {"source":"/api/*","target":null,"query":"not redirected","status":"API namespace preserved","reason":"API paths must never become HTML redirects"}
  ],
  "negative_cases": ["//external.example", "https://external.example", "/%2f%2fexternal.example", "\\\\external.example"]
}
