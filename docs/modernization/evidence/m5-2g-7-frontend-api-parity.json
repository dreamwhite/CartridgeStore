{
  "abi": "prg32-frontend-api-parity-1.0",
  "milestone": "M5.2g.7",
  "client_rules": {
    "credentials": "same-origin by default; include only for explicitly enabled dual-origin mode",
    "csrf": "GET /auth/csrf before cookie-authenticated mutations",
    "errors": "stable {ok:false,error,code?} envelope; raw server exceptions are not rendered",
    "origins": "no hardcoded deployment origin; Next proxy or explicit configured API origin only"
  },
  "consumers": [
    {"client":"catalog","method":"GET","path":"/api/games","response":"gamesResponseSchema","auth":"anonymous","csrf":false},
    {"client":"catalog","method":"GET","path":"/api/games/:id","response":"gameResponseSchema","auth":"anonymous","csrf":false},
    {"client":"catalog","method":"GET","path":"/api/games/:id/{icon,screenshot,colophon,download}","response":"binary/media or compatible API","auth":"anonymous","csrf":false},
    {"client":"scores","method":"GET","path":"/api/scores","response":"scoresSchema","auth":"anonymous","csrf":false},
    {"client":"statistics","method":"GET","path":"/api/stats/{downloads,scores,runs}","response":"statistics schemas","auth":"anonymous aggregate","csrf":false},
    {"client":"auth","method":"GET","path":"/auth/csrf","response":"csrfResponseSchema","auth":"anonymous session","csrf":false},
    {"client":"auth","method":"POST","path":"/auth/login","response":"authUserResponseSchema","auth":"anonymous","csrf":true},
    {"client":"auth","method":"POST","path":"/auth/logout","response":"authLogoutResponseSchema","auth":"authenticated","csrf":true},
    {"client":"auth","method":"GET","path":"/auth/me","response":"authUserResponseSchema","auth":"authenticated","csrf":false},
    {"client":"auth","method":"GET/POST/PATCH/DELETE","path":"/auth/tokens[/:id]","response":"token schemas","auth":"authenticated owner","csrf":true},
    {"client":"auth","method":"POST","path":"/auth/register","response":"registrationRequestedResponseSchema","auth":"anonymous","csrf":true},
    {"client":"auth","method":"POST","path":"/auth/register/complete","response":"authUserResponseSchema","auth":"registration token","csrf":true},
    {"client":"workflow","method":"GET/POST","path":"/api/submissions[/:id], /api/publish/bundle","response":"workflow schemas","auth":"authenticated permission","csrf":"true for mutations"},
    {"client":"metrics","method":"GET","path":"/api/runs[/:id]","response":"metrics schemas","auth":"owner/admin","csrf":false},
    {"client":"metrics","method":"GET","path":"/api/runs/:id/{samples.csv,report.md}","response":"authorized export","auth":"owner/admin","csrf":false},
    {"client":"profile","method":"GET","path":"/api/users/:username","response":"userProfileResponseSchema","auth":"public summary","csrf":false},
    {"client":"profile","method":"GET","path":"/api/users/:username/runs[/:run_id]","response":"userRunsResponseSchema/userRunResponseSchema","auth":"owner/admin","csrf":false},
    {"client":"admin","method":"GET/PATCH/POST/DELETE","path":"/__admin-fastify/*","response":"admin contracts","auth":"administrator/permission","csrf":"true for mutations"},
    {"client":"federation","method":"GET/PATCH/POST","path":"/api/admin/federation/*","response":"federation contracts","auth":"administrator/reauthenticated","csrf":"true for mutations"}
  ],
  "flask_only_consumers": [],
  "stale_hardcoded_origins": []
}
