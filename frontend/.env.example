# Standard backend-neutral upstream for Next.js server-side rewrites.
PRG32_API_UPSTREAM=http://127.0.0.1:5090

# Explicit legacy compatibility path for the current Flask development service.
# Do not set both PRG32_API_UPSTREAM and FLASK_PROXY_TARGET.
# FLASK_PROXY_TARGET=http://127.0.0.1:5080

# Optional isolated administrative Fastify target for disposable development/test only.
# Never set this for a production build.
# PRG32_ADMIN_FASTIFY_TARGET=http://127.0.0.1:5090

# Next.js rewrites are HTTP-only; configure the corresponding backend WebSocket URL separately.
NEXT_PUBLIC_PRG32_WS_URL=ws://127.0.0.1:5090/api/multiplayer
