# HTTP requests from Next.js are rewritten to this Flask compatibility target during migration.
FLASK_PROXY_TARGET=http://127.0.0.1:5080

# Optional isolated administrative Fastify target for disposable development/test only.
# Never set this for a production build; the normal Flask-compatible proxy remains the default.
# PRG32_ADMIN_FASTIFY_TARGET=http://127.0.0.1:5090

# Next.js rewrites are HTTP-only; use the Flask endpoint until a WS-capable proxy is introduced.
NEXT_PUBLIC_FLASK_WS_URL=ws://127.0.0.1:5080/api/multiplayer
